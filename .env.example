# Emet Echo Environment Configuration
# Copy this to .env and fill in your values. Never commit real secrets.
# Required for the app to start and function.

# Flask / Security (REQUIRED - no default in code)
SESSION_SECRET=change-this-to-a-long-random-string-for-production

# Database (REQUIRED - Postgres)
# Example: postgresql://user:pass@host:5432/emetecho
# For local dev you can temporarily use sqlite:///dev.db but some raw SQL (e.g. in old migrations) and psycopg2 features assume Postgres.
DATABASE_URL=postgresql://user:password@localhost:5432/emetecho

# News aggregation
NEWS_API_KEY=your_newsapi_key_here

# AI (OpenAI) - used for EO analysis, home digests, article bias, quips, etc.
OPENAI_API_KEY=sk-...

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_key_here
# From address is hardcoded to info@emetecho.com in code; change in blueprints/email.py if needed.

# Printify shop integration (merch)
PRINTIFY_API_TOKEN=your_printify_token_here

# X / Twitter monitoring via RSSHub (optional, defaults to public rsshub.app)
RSSHUB_BASE_URL=https://rsshub.app

# Admin protection for /admin/x-handles (highly recommended)
# Set this and pass ?token=... on GET or as form field / header X-Admin-Token on POST.
# The page will 403 without it.
ADMIN_TOKEN=change-this-to-another-long-random-string

# Background jobs (scheduler for news refresh + daily digests)
# IMPORTANT for gunicorn/multi-worker deploys: run the scheduler in EXACTLY ONE process.
# Web workers: normal gunicorn
# Scheduler worker (one only):
#   RUN_SCHEDULER=1 gunicorn -w 1 main:app
# or
#   RUN_SCHEDULER=1 python -c '
#     import os
#     os.environ["DATABASE_URL"] = "..."
#     os.environ["SESSION_SECRET"] = "..."
#     from app import app
#     with app.app_context():
#         # the module level will pick it up, or call explicitly
#         import time; time.sleep(3600)
#   '
RUN_SCHEDULER=0

# Schema / DB bootstrap (run on deploy or fresh DBs):
#   python scripts/migrate.py
# (safe to run repeatedly; replaces the old auto-DDL that used to happen on every start)

# OpenAI cost controls (used by ai_client.py budget enforcement)
# Set either or both. 0 or unset = unlimited (current default behavior).
OPENAI_DAILY_BUDGET_USD=5.00
OPENAI_DAILY_TOKEN_CAP=200000
# Optional: override the usage file location
# OPENAI_USAGE_FILE=.openai_usage.json

# Rough pricing is hardcoded for gpt-4o in ai_client.py. You can tune _PRICE_PER_1K if your model mix changes.

# Optional: set to "1" to enable DEBUG logging and Flask debug mode (never in prod)
# FLASK_DEBUG=0

# Notes:
# - The app does aggressive top-level side effects on import (threads, DB ops).
#   Use gunicorn with proper worker management in production.
# - No python-dotenv is used; the platform or shell must provide the env vars.
# - Add more vars here as features grow (e.g. for future rate limiting, cost caps).
